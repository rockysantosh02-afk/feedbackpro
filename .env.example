# FeedbackPro Environment Configuration
# IMPORTANT: Copy this file to .env and fill in production secrets. Never commit .env!

# Environment & Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database
# Production (PostgreSQL 14+): postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=

# Security & Authentication (Generate with: openssl rand -base64 32)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Worker Queue Configuration
# Options: "database" (built-in transactional PostgreSQL queue), "redis"
QUEUE_TYPE=database
REDIS_URL=redis://localhost:6379/0
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENT_JOBS=3

# AI Provider Configuration
# Options: "deterministic" (offline testing, 100% reliable, zero API keys required), "openai", "gemini"
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Email Provider Configuration
# Options: "mock", "smtp", "resend"
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@feedbackpro.ai
RESEND_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Safe Audit Scanner Boundaries
SCANNER_MAX_REDIRECTS=5
SCANNER_CONNECT_TIMEOUT_SECONDS=5.0
SCANNER_READ_TIMEOUT_SECONDS=10.0
SCANNER_MAX_RESPONSE_BYTES=5242880
SCANNER_USER_AGENT="FeedbackPro-SecurityAuditor/1.0 (+https://feedbackpro.ai/bot-info)"
SCANNER_MAX_PAGES=5

# Rate Limits
RATE_LIMIT_PUBLIC_BURST=30/minute
RATE_LIMIT_PUBLIC_SUBMIT=5/minute
RATE_LIMIT_AUDIT_TRIGGER=3/10minutes
