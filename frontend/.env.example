# FeedbackPro Frontend Environment Variables Template
# Copy this file to .env.local for local development.
# Do NOT commit real credentials or secrets to version control.

# Backend API URL (leave empty in production to use relative /api reverse proxy)
VITE_API_URL=
VITE_API_BASE_URL=

# Firebase Web App Client Configuration (Public configuration from Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
