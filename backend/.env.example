# FeedbackPro Backend Environment Configuration Template
# Copy this file to .env in backend/ or root for backend execution.
# Do NOT commit real credentials or secrets to version control.

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=

# Legacy JWT & Session Security
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
IP_HASH_SALT=

# Firebase Admin SDK Configuration (Server-Side Only - NEVER expose to Frontend)
FIREBASE_PROJECT_ID=feedbackpro-d2e02
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_ENABLED=true

# Worker Queue Configuration
QUEUE_TYPE=database
REDIS_URL=redis://localhost:6379/0
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENT_JOBS=3
INLINE_AUDIT_EXECUTION=false

# AI Provider Configuration
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Email Provider Configuration
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@feedbackpro.ai
RESEND_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
